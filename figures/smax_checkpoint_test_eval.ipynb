          "text": [
            "Protocol assertions passed.\n"
          ]
        }
      ],
      "source": [
        "for map_name, result in MAP_RESULTS.items():\n",
        "    run_df = result[\"run_results\"].copy()\n",
        "    seed_summary = result[\"seed_summary\"].copy()\n",
        "    model_summary = result[\"model_summary\"].copy()\n",
        "\n",
        "    eval_seed_sets = (\n",
        "        run_df.groupby([\"constraint_key\", \"model_label\", \"train_seed\"])[\"eval_seed\"]\n",
        "        .agg(lambda values: tuple(sorted(set(int(v) for v in values))))\n",
        "        .reset_index(name=\"eval_seed_set\")\n",
        "    )\n",
        "    method_seed_counts = eval_seed_sets.groupby([\"constraint_key\", \"model_label\"])[\"eval_seed_set\"].nunique()\n",
        "    assert (method_seed_counts == 1).all(), f\"Inconsistent eval_seed sets detected for {map_name}:\\n{method_seed_counts}\"\n",
        "\n",
        "    assert not (run_df[\"train_seed\"] == run_df[\"eval_seed\"]).any(), f\"train_seed and eval_seed collided for {map_name}\"\n",
        "\n",
        "    expected_seed_rows = (\n",
        "        run_df.groupby([\"constraint_key\", \"model_label\"])[\"train_seed\"]\n",
        "        .nunique()\n",
        "        .reset_index(name=\"expected_rows\")\n",
        "    )\n",
        "    actual_seed_rows = (\n",
        "        seed_summary.groupby([\"constraint_key\", \"model_label\"])\n",
        "        .size()\n",
        "        .reset_index(name=\"actual_rows\")\n",
        "    )\n",
        "    row_check = expected_seed_rows.merge(actual_seed_rows, on=[\"constraint_key\", \"model_label\"], how=\"left\")\n",
        "    assert (row_check[\"expected_rows\"] == row_check[\"actual_rows\"]).all(), f\"seed_summary row mismatch for {map_name}:\\n{row_check}\"\n",
        "\n",
        "    expected_std = (\n",
        "        seed_summary.groupby([\"constraint_key\", \"model_label\"])[\"eval_success_rate\"]\n",
        "        .std()\n",
        "        .reset_index(name=\"expected_std_success_rate\")\n",
        "    )\n",
        "    std_check = model_summary.merge(expected_std, on=[\"constraint_key\", \"model_label\"], how=\"left\")\n",
        "    observed = std_check[\"std_success_rate\"].fillna(0.0).to_numpy()\n",
        "    expected = std_check[\"expected_std_success_rate\"].fillna(0.0).to_numpy()\n",
        "    assert ((observed - expected).__abs__() < 1.0e-12).all(), f\"std_success_rate mismatch for {map_name}:\\n{std_check}\"\n",
        "\n",
        "    if DUPLICATE_POLICY != \"all\":\n",
        "        assert (seed_summary[\"n_runs\"] == 1).all(), f\"duplicate runs leaked into seed_summary for {map_name}:\\n{seed_summary[['constraint_key', 'model_label', 'seed', 'n_runs']]}\"\n",
        "\n",
        "print(\"Protocol assertions passed.\")\n"
      ]
    },
