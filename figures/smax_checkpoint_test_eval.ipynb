      "source": [
        "SMOKE_EVAL_SEEDS = EVAL_SEEDS[:2]\n",
        "\n",
        "smoke_row = runs_df.sort_values([\"map_name\", \"constraint_key\", \"model_label\", \"seed\", \"run_dir\"]).iloc[0]\n",
        "SMOKE_MAP = smoke_row[\"map_name\"]\n",
        "SMOKE_CONSTRAINT = smoke_row[\"constraint_key\"]\n",
        "SMOKE_MODEL = smoke_row[\"model_label\"]\n",
        "SMOKE_SEED = int(smoke_row[\"seed\"])\n",
        "\n",
        "smoke_runs = runs_df[\n",
        "    (runs_df[\"map_name\"] == SMOKE_MAP)\n",
        "    & (runs_df[\"constraint_key\"] == SMOKE_CONSTRAINT)\n",
        "    & (runs_df[\"model_label\"] == SMOKE_MODEL)\n",
        "    & (runs_df[\"seed\"] == SMOKE_SEED)\n",
        "].copy()\n",
        "\n",
        "display(smoke_runs[[\"map_name\", \"constraint_key\", \"model_label\", \"seed\", \"wandb_run_name\", \"run_dir\"]])\n",
        "\n",
        "smoke_result = evaluate_map_constraint(\n",
        "    smoke_runs,\n",
        "    SMOKE_MAP,\n",
        "    SMOKE_CONSTRAINT,\n",
        "    checkpoint_choice=CHECKPOINT_CHOICE,\n",
        "    device=DEVICE,\n",
        "    eval_episodes=EVAL_EPISODES,\n",
        "    eval_seeds=SMOKE_EVAL_SEEDS,\n",
        "    eval_seed_batch_size=min(EVAL_SEED_BATCH_SIZE, len(SMOKE_EVAL_SEEDS)),\n",
        "    duplicate_policy=DUPLICATE_POLICY,\n",
        ")\n",
        "display(smoke_result[\"run_results\"])\n",
        "display(smoke_result[\"seed_summary\"])\n",
        "display(smoke_result[\"model_summary\"])\n"
      ]
    },
