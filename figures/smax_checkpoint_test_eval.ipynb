        "        map_name,\n",
        "        checkpoint_choice=CHECKPOINT_CHOICE,\n",
        "        device=DEVICE,\n",
        "        eval_episodes=EVAL_EPISODES,\n",
        "        eval_seeds=EVAL_SEEDS,\n",
        "        eval_seed_batch_size=EVAL_SEED_BATCH_SIZE,\n",
        "        model_order=TARGET_MODELS,\n",
        "        duplicate_policy=DUPLICATE_POLICY,\n",
        "    )\n",
        "    if result[\"model_summary\"].empty:\n",
        "        print(f\"Skipping {map_name}: no discovered runs\")\n",
        "        continue\n",
        "    MAP_RESULTS[map_name] = result\n",
        "    print(f\"\\n=== {map_name} ===\")\n",
        "    display(result[\"seed_summary\"])\n",
        "    display(result[\"model_summary\"])\n",
        "    print(result[\"latex\"])\n"
      ]
