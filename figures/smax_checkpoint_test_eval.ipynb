      "metadata": {},
      "source": [
        "# SMAX checkpoint evaluation\n",
        "\n",
        "This notebook evaluates saved SMAX checkpoints with deterministic rollouts and reports paper-table win rates at the training-seed level.\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 29,
      "id": "074ee22b",
      "metadata": {},
      "outputs": [
        {
          "name": "stdout",
          "output_type": "stream",
          "text": [
            "The history saving thread hit an unexpected error (OperationalError('database or disk is full')).History will not be written to the database.\n"
          ]
        }
      ],
      "source": [
        "import importlib\n",
        "import os\n",
        "import sys\n",
        "from pathlib import Path\n",
        "\n",
        "import pandas as pd\n",
        "import torch\n",
        "from IPython.display import display\n",
        "\n",
        "\n",
        "def resolve_repo_root() -> Path:\n",
        "    cwd = Path.cwd().resolve()\n",
        "    for candidate in (cwd, cwd.parent):\n",
        "        if (candidate / \"main.py\").is_file() and (candidate / \"figures\").is_dir():\n",
        "            return candidate\n",
        "    raise FileNotFoundError(\"Could not locate the pci_marl repo root from the current notebook working directory.\")\n",
        "\n",
        "\n",
        "ROOT = resolve_repo_root()\n",
        "FIGURES_DIR = ROOT / \"figures\"\n",
        "for path in (ROOT, FIGURES_DIR):\n",
        "    path_str = str(path)\n",
        "    if path_str not in sys.path:\n",
        "        sys.path.insert(0, path_str)\n",
        "\n",
        "command_buffer_flag = \"--xla_gpu_enable_command_buffer=\"\n",
        "existing_xla_flags = os.environ.get(\"XLA_FLAGS\", \"\")\n",
        "if command_buffer_flag not in existing_xla_flags:\n",
        "    os.environ[\"XLA_FLAGS\"] = f\"{existing_xla_flags} {command_buffer_flag}\".strip()\n",
        "os.environ.setdefault(\"XLA_PYTHON_CLIENT_PREALLOCATE\", \"false\")\n",
        "\n",
        "import smax_checkpoint_eval_utils as scu\n",
        "scu = importlib.reload(scu)\n",
        "\n",
        "bootstrap_project = scu.bootstrap_project\n",
        "discover_runs = scu.discover_runs\n",
        "evaluate_map = scu.evaluate_map\n",
        "evaluate_map_constraint = scu.evaluate_map_constraint\n",
        "format_cross_map_latex = scu.format_cross_map_latex\n",
        "ordered_map_names = scu.ordered_map_names\n",
        "ordered_model_labels = scu.ordered_model_labels\n",
        "save_summary_tables = scu.save_summary_tables\n",
        "\n",
        "DEVICE = \"cpu\"\n",
        "CHECKPOINT_CHOICE = \"final\"  # or \"best\"\n",
        "DUPLICATE_POLICY = \"latest\"  # curated checkpoints_for_eval notebook policy; utility default remains \"error\"\n",
        "EVAL_SEEDS = list(range(10001, 10065))\n",
        "EVAL_EPISODES = 1\n",
        "EVAL_SEED_BATCH_SIZE = 16\n",
        "MAP_RESULTS = {}\n",
        "\n",
        "bootstrap_project(DEVICE)\n",
        "runs_df = discover_runs(ROOT / \"checkpoints_for_eval\", project_filter=None)\n",
        "if runs_df.empty:\n",
        "    raise RuntimeError(\"No runs were discovered under checkpoints_for_eval\")"
      ]
    },
